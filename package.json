{
  "name": "shale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"bun run dev:server\" \"bun run dev:web\"",
    "dev:server": "bun src/server/preflight.ts && bun --hot src/server/index.ts",
    "dev:web": "vite",
    "start": "bun src/server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "package:docker": "docker build --tag shale:0.1.0 .",
    "test": "vitest run",
    "test:integration": "bun test tests/integration",
    "test:e2e": "playwright test",
    "test:smoke": "bash scripts/docker-smoke.sh",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hono/zod-validator": "0.9.0",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.5",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.2",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.3.11",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
